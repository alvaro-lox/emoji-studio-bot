# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token

# Пак премиум-эмодзи, из которого берутся иконки для текста и кнопок
ICON_PACK=tgiosicons
# 1 — показывать премиум-иконки (нужен Telegram Premium у владельца бота), 0 — обычные эмодзи
CUSTOM_EMOJI=1

# Сколько секунд ждать следующих сообщений, прежде чем собрать zip
BATCH_DELAY=2.5

# Подарки: сколько анимаций рендерить одновременно и масштаб (3 = 1260×840)
RENDER_WORKERS=2
GIFT_SCALE=3
# Свой шрифт для подписей (необязательно)
FONT_PATH=

# Где хранить базу и кэш рендеров
DATA_DIR=data

# Админы через запятую (свой ID можно узнать командой /myid)
ADMIN_IDS=
# Лимит тяжёлых действий (рендер, перекраска, эмодзи, паки): столько за окно в секундах
HEAVY_LIMIT=6
HEAVY_WINDOW=60
# Как часто проверять владельцев подарков (секунды) и сколько подарков можно отслеживать
WATCH_INTERVAL=900
MAX_WATCHES=20
