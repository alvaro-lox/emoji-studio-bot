# Запуск без Docker: скопируй в /etc/systemd/system/emoji-bot.service,
# поправь пути и пользователя, затем:
#   sudo systemctl daemon-reload && sudo systemctl enable --now emoji-bot
[Unit]
Description=Telegram Emoji Studio bot
After=network-online.target
Wants=network-online.target

[Service]
User=bot
WorkingDirectory=/opt/emoji-bot
ExecStart=/opt/emoji-bot/.venv/bin/python -m app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
